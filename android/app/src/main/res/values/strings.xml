    <!-- Settings -->
    <string name="setting_connections">Connections per download</string>
    <string name="setting_connections_help">A file is split into parts fetched at the same time. More is faster until the server or your network says no; the app learns each server\'s limit and backs off by itself. Some ROM hosts allow only a few: if downloads fail to start, lower it.</string>
    <string name="setting_active">Downloads at once</string>
    <string name="setting_active_help">The others wait in the queue.</string>
    <string name="setting_speed">Speed limit</string>
    <string name="setting_speed_help">For all downloads together.</string>
    <string name="setting_unlimited">Unlimited</string>
    <string name="setting_direct">Save straight to a folder</string>
    <string name="setting_direct_help">Fastest for big files such as ROMs: the file is written where it belongs, with no copy afterwards and no second copy taking up space. Needs “All files access”. Without this, files are copied to Downloads when finished.</string>
